    {
      "id": "sec-safety",
      "title": "ملاحظات السلامة",
      "type": "safety",
      "order": 6,
      "blocks": [
        {
          "type": "safety_note",
          "order": 1,
          "message": {
            "ar": "ارتدِ القفازات والنظارات عند التعامل مع الخرسانة الطازجة لتجنب التهيج أو الحروق الجلدية."
          },
          "severity": "medium"
        },
        {
          "type": "safety_note",
          "order": 2,
          "message": {
            "ar": "تعامل بحذر مع القوالب والمكعبات لأنها ثقيلة وقد تسبب إصابات عند الرفع أو النقل."
          },
          "severity": "medium"
        },
        {
          "type": "safety_note",
          "order": 3,
          "message": {
            "ar": "لا تقف قريباً من ماكينة الضغط أثناء الفحص إلا ضمن إجراءات المختبر، لأن الكسر قد يسبب تطاير أجزاء صغيرة."
          },
          "severity": "high"
        }
      ]
    },
    {
      "id": "sec-code-reference",
      "title": "المراجع والملاحظات الفنية",
      "type": "codeReference",
      "order": 7,
      "blocks": [
        {
          "type": "code_reference",
          "order": 1,
          "code": "ASTM C39 / BS EN 12390-3 / Iraqi Specifications",
          "title": {
            "ar": "مراجع فنية لفحص مكعبات الخرسانة"
