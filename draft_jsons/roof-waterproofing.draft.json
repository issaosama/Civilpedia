          },
          "notes": {
            "ar": "البرايمر يعزز الالتصاق — اتبع تعليمات الشركة المصنعة لكل مادة."
          }
        },
        {
          "type": "execution_step",
          "order": 5,
          "stepNumber": 5,
          "description": {
            "ar": "تنفيذ العزل حول المصارف والزوايا والحافات أولاً حسب التفاصيل"
          },
          "notes": {
            "ar": "المصارف والزوايا هي أكثر نقاط التسرب — عالجها أولاً وبشكل منفصل."
          }
        },
        {
          "type": "execution_step",
          "order": 6,
          "stepNumber": 6,
          "description": {
            "ar": "تركيب أو تطبيق طبقة العزل الرئيسية مع الالتزام بالتراكب المطلوب (يحتاج تدقيق)"
          },
          "notes": {
            "ar": "مقدار التراكب يختلف حسب نظام العزل — لا تنقصه لتوفير المادة."
          }
        },
        {
          "type": "execution_step",
          "order": 7,
          "stepNumber": 7,
          "description": {
            "ar": "رفع العزل على الحافات والجدران الصغيرة Upturn حسب التفاصيل (يحتاج تدقيق)"
          },
          "notes": {
            "ar": "الـ Upturn ضروري لمنع دخول الماء من الأطراف والحافات."
          }
        },
        {
          "type": "execution_step",
          "order": 8,
          "stepNumber": 8,
          "description": {
            "ar": "فحص اللحامات أو مناطق التراكب والاختراقات"
          },
          "notes": {
            "ar": "الاختراقات مثل أعمدة الصرف الصحي والكهرباء تحتاج معالجة خاصة."
          }
        },
        {
          "type": "execution_step",
          "order": 9,
          "stepNumber": 9,
          "description": {
            "ar": "تنفيذ اختبار الغمر أو اختبار التسرب حسب متطلبات المشروع (يحتاج تدقيق)"
          },
          "notes": {
            "ar": "اختبار العزل يكشف التسرب قبل تغطيته — لا تتجاوز هذه الخطوة."
          }
        },
        {
          "type": "execution_step",
          "order": 10,
          "stepNumber": 10,
          "description": {
            "ar": "تنفيذ طبقة حماية وعدم السماح بتلف العزل أثناء الأعمال اللاحقة"
          },
          "notes": {
            "ar": "العزل بدون حماية يتعرض للتمزق والثقب من الحركة والأعمال اللاحقة."
          }
        }
      ]
