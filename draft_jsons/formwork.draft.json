  "sections": [
    {
      "id": "sec-overview",
      "title": "نظرة عامة",
      "type": "general",
      "order": 1,
      "blocks": [
        {
          "type": "text",
          "order": 1,
          "content": {
            "ar": "القالب الخشبي أو الشدة الخشبية هو الهيكل المؤقت اللي يشكل الخرسانة الطازجة ويعطيها الشكل والأبعاد والمناسيب المطلوبة لحين تصلبها. جودة تنفيذ القالب تأثر بشكل مباشر على جودة الخرسانة المطبوعة، وتساعد على منع التسرب والتشوهات والفشل أثناء الصب."
          },
          "variant": "paragraph"
        },
        {
          "type": "text",
          "order": 2,
          "content": {
            "ar": "فشل القالب أثناء الصب من أخطر المشاكل اللي ممكن تصير بالموقع. إذا انفتح القالب أو انبعج أو سقط، النتيجة تكون تأخير وخسارة مادية كبيرة وإصابة محتملة للعمال. لذلك الفحص الدقيق قبل الصب ضروري وليس اختياري."
          },
          "variant": "note"
        },
        {
          "type": "table",
          "order": 3,
          "caption": {
            "ar": "شنو نراجع بالقالب قبل الصب؟"
          },
          "headers": [
            "العنصر",
            "سبب المراجعة",
            "ملاحظات"
          ],
          "rows": [
            {
              "cells": [
                "الأبعاد",
                "لضمان مطابقة العنصر للمخطط",
                "يجب القياس المباشر"
              ]
            },
            {
              "cells": [
                "المناسيب",
                "لضمان مستوى العنصر الصحيح",
                "يحتاج ربط مع Bench Mark"
              ]
            },
            {
              "cells": [
                "الاستقامة والعمودية",
                "لمنع الميلان أو البروز",
                "تفحص بالخيط والميزان"
              ]
            },
            {
              "cells": [
                "الدعم والربط",
