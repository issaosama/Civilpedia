  "sections": [
    {
      "id": "sec-overview",
      "title": "نظرة عامة",
      "type": "general",
      "order": 1,
      "blocks": [
        {
          "type": "text",
          "order": 1,
          "content": {
            "ar": "أعمال التسليح هي واحدة من أهم مراحل العمل الإنشائي، لأن حديد التسليح هو العنصر الرئيسي اللي يتحمل قوى الشد والضغط جنب الخرسانة. أي خطأ بالقطر أو العدد أو المسافات أو الغطاء أو التراكب ممكن يأثر على متانة وسلامة المبنى وحتى يسبب فشل بعد الصب. مهندس الموقع لازم يتأكد من كل التفاصيل قبل ما يسمح بالصب."
          },
          "variant": "paragraph"
        },
        {
          "type": "text",
          "order": 2,
          "content": {
            "ar": "أخطاء صغيرة بالتسليح مثل نقص الغطاء أو تراكب غير صحيح أو استخدام قطر مختلف قد لا تظهر مباشرة بعد الصب، لكنها تؤثر على عمر المبنى وسلامته. التدقيق الدقيق قبل الصب هو الفرق بين عمل مضبوط ومشكلة بعد الصب."
          },
          "variant": "note"
        },
        {
          "type": "table",
          "order": 3,
          "caption": {
            "ar": "عناصر يجب فهمها قبل استلام التسليح"
          },
          "headers": [
            "العنصر",
            "شنو يعني؟",
            "شنو أراجع؟"
          ],
          "rows": [
            {
              "cells": [
                "قطر الحديد Bar Diameter",
                "سمك قضيب الحديد بالملم",
                "القطر المطلوب بالمخطط مقابل القطر الموجود بالموقع"
              ]
            },
            {
              "cells": [
                "عدد القضبان Number of Bars",
                "عدد القضبان المطلوبة لكل عنصر",
                "عد القضبان وتطابق العدد مع المخطط"
              ]
            },
            {
              "cells": [
                "المسافات Spacing",
                "المسافة بين محور قضيب والثاني",
                "القياس الفعلي ومطابقته للمخطط"
              ]
            },
            {
              "cells": [
                "الغطاء الخرساني Concrete Cover",
                "المسافة بين الحديد وسطح الخرسانة لحماية الحديد من الصدأ",
                "قياس الغطاء من الحديد لحافة القالب"
              ]
            },
            {
              "cells": [
                "التراكب Lap Splice",
                "طول تداخل قضيبين لضمان استمرارية القوى",
                "طول التراكب وموقعه حسب المواصفة (يحتاج تدقيق)"
              ]
            },
            {
              "cells": [
                "الكانات Stirrups / Ties",
                "قضبان جانبية لتثبيت الحديد الطولي ومنع الانبعاج",
                "القطر والمسافة وطريقة الربط"
              ]
            },
            {
              "cells": [
                "الكراسي Chairs / Supports",
                "قضبان أو قطع لتثبيت الحديد العلوي ومنع هبوطه",
                "عددها وتوزيعها وقوتها"
              ]
            },
            {
              "cells": [
                "نظافة الحديد Rebar Cleanliness",
                "خلو الحديد من الطين والزيوت والصدأ المؤثر",
                "الفحص البصري قبل الصب"
              ]
            }
          ]
        }
      ]
    },
