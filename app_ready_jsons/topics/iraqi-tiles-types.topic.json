    "sec-common-mistakes-tiles": [
      {
        "type": "text",
        "order": 1,
        "content": "لصق البورسلين بطريقة النقاط بدل الفرش الكامل — يؤدي إلى فراغات وتطبيل وكسر تحت الأحمال.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 2,
        "content": "استخدام سيراميك حوائط للأرضيات — سيراميك الحوائط أقل مقاومة للبلي والكسر ولا يتحمل المشاة.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 3,
        "content": "إهمال الميول في الحمامات والسطوح — يؤدي إلى تجمع المياه والرطوبة والتسربات.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 4,
        "content": "التبليط بدون فواصل تمدد في المساحات الكبيرة — يؤدي إلى انبعاج أو تشقق البلاط نتيجة التمدد الحراري.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 5,
        "content": "خلط دفعات إنتاج مختلفة من البلاط — يؤدي إلى اختلاف في اللون والأبعاد بين البلاطات.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 6,
        "content": "ترويب المرمر الفاتح بروبة رمادية غير مناسبة — تترك بقعاً دائمة يصعب إزالتها.",
        "variant": "warning"
      },
      {
        "type": "text",
        "order": 7,
        "content": "الترويب قبل جفاف المونة بشكل كامل — يؤدي إلى تشقق الروبة وضعف التماسك.",
        "variant": "warning"
      }
    ],
