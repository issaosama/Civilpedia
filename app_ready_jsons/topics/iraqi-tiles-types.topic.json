      {
        "type": "text",
        "order": 4,
        "content": "تختلف الأسعار والجودة بشكل ملحوظ حسب المنشأ والشركة المصنعة والدفعة الإنتاجية. يُفضّل الحصول على عينات من الدفعة المراد شراؤها قبل الشراء لفحص الاتساق في اللون والأبعاد.",
        "variant": "note"
      }
    ],
    "sec-execution": [
      {
        "type": "execution_step",
        "order": 1,
        "step": {
          "stepNumber": 1,
          "description": "تجهيز السطح والتأكد من النظافة والاستواء.",
          "notes": "يجب إزالة الأتربة والدهون والشوائب، ومعالجة أي عيوب في سطح الخرسانة قبل البدء."
        }
      },
      {
        "type": "execution_step",
        "order": 2,
        "step": {
          "stepNumber": 2,
          "description": "توزيع البلاط جافاً لتحديد القصاصات واتجاه التبليط.",
          "notes": "يُفضّل بدء التبليط من منتصف المساحة أو من الزاوية الأكثر ظهوراً في الفراغ."
        }
      },
      {
        "type": "execution_step",
        "order": 3,
        "step": {
          "stepNumber": 3,
          "description": "فرد المونة اللاصقة بالمسنن المناسب.",
          "notes": "استخدم مسنن 6 مم للسيراميك و10 مم للبورسلين لضمان التصاق كافٍ."
        }
      },
      {
        "type": "execution_step",
        "order": 4,
        "step": {
          "stepNumber": 4,
          "description": "تركيب البلاط مع الضغط والتحريك الخفيف.",
          "notes": "تأكد من تغطية المونة لأكبر مساحة من ظهر البلاطة. يحتاج البورسلين فرشاً كاملاً وليس لصقاً نقتطي."
        }
      },
      {
        "type": "execution_step",
        "order": 5,
        "step": {
          "stepNumber": 5,
          "description": "ضبط الفواصل بالصلبان البلاستيكية.",
          "notes": "يفضّل فواصل 2-3 مم للسيراميك و3-5 مم للبلاط كبير الأبعاد والبورسلين."
        }
      },
      {
        "type": "execution_step",
        "order": 6,
        "step": {
          "stepNumber": 6,
          "description": "تسوية البلاط بميزان الماء والجاكوش المطاطي.",
          "notes": "راجع الاستواء في جميع الاتجاهات فور تركيب كل بلاطة قبل جفاف المونة."
        }
      },
      {
        "type": "execution_step",
        "order": 7,
        "step": {
          "stepNumber": 7,
          "description": "الترويب بعد جفاف المونة.",
          "notes": "اترك المونة تجف لمدة 24-48 ساعة قبل الترويب. اختر لون الروبة المناسب خاصة للمرمر الفاتح."
        }
      },
      {
        "type": "execution_step",
        "order": 8,
        "step": {
          "stepNumber": 8,
          "description": "تنظيف وحماية السطح بعد الترويب.",
          "notes": "نظف سطح البلاط من بقايا الروبة فوراً. امنع المشاة عن السطح لمدة 48 ساعة على الأقل."
        }
      }
    ],
